version: 1

repositories:
  - type: git
    url: https://github.com/todor-mazgalov/forjis-plugins.git
    ref: main

plugins:
  - name: software-dev

pipeline:
  mode: swarm

orgs:
  - name: forjis
    teams:
      - name: Research
        extends: software-dev:RnD:Research
      - name: Backend
        extends: software-dev:RnD:NodeJS
      - name: Frontend
        extends: software-dev:RnD:SolidJS

personas:
  dir: "./personas"
  
tasks:
  source: dir
  path: ./tasks

constraints:
  include: 
    - software-dev:git
  pillars:
    - pillars/architecture.md
    - pillars/data.md