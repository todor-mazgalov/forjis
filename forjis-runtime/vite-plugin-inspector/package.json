{
  "name": "@forjis/vite-inspector",
  "version": "0.5.1",
  "description": "Vite plugin that mounts @forjis/inspector into dev HTML and stamps JSX elements with data-forjis-src source locations.",
  "keywords": ["forjis", "inspector", "vite", "plugin", "jsx"],
  "homepage": "https://github.com/todor-mazgalov/forjis#readme",
  "bugs": { "url": "https://github.com/todor-mazgalov/forjis/issues" },
  "license": "MIT",
  "author": "Todor Mazgalov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/todor-mazgalov/forjis.git",
    "directory": "forjis-runtime/vite-plugin-inspector"
  },
  "engines": { "node": ">=20" },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc",
    "test": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js --forceExit --testTimeout=60000",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@babel/core": "^7.27.0",
    "@babel/plugin-syntax-jsx": "^7.25.0",
    "@babel/traverse": "^7.27.0"
  },
  "peerDependencies": {
    "vite": ">=5"
  },
  "devDependencies": {
    "@types/babel__core": "^7.20.5",
    "@types/babel__traverse": "^7.20.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "jest": "^30.0.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.5.0",
    "vite": "^5.0.0"
  }
}
