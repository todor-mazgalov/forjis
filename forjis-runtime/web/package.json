{
  "name": "@forjis/web",
  "version": "0.5.1",
  "description": "Forjis web dashboard — HTTP server, router, controllers",
  "keywords": [
    "forjis",
    "dashboard",
    "web",
    "http"
  ],
  "homepage": "https://github.com/todor-mazgalov/forjis#readme",
  "bugs": {
    "url": "https://github.com/todor-mazgalov/forjis/issues"
  },
  "license": "MIT",
  "author": "Todor Mazgalov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/todor-mazgalov/forjis.git",
    "directory": "forjis-runtime/web"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "client/dist",
    "client/README.md",
    "client/index.html",
    "client/package.json",
    "client/vite.config.ts",
    "client/tsconfig.json",
    "client/public",
    "client/src"
  ],
  "scripts": {
    "build": "tsc",
    "postbuild": "cd client && npm ci && npm run build",
    "test": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js --forceExit --testTimeout=60000",
    "clean": "rm -rf dist client/dist"
  },
  "dependencies": {
    "@forjis/shared": "0.5.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.0",
    "@types/ws": "^8.5.14",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.5.0",
    "yaml": "^2.7.0",
    "playwright": "^1.59.1"
  }
}
