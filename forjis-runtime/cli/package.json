{
  "name": "@forjis/cli",
  "version": "0.5.1",
  "description": "Forjis CLI — entry point for the AI-powered software development pipeline",
  "keywords": ["forjis", "cli", "llm-agents", "claude-code", "pipeline"],
  "homepage": "https://github.com/todor-mazgalov/forjis#readme",
  "bugs": { "url": "https://github.com/todor-mazgalov/forjis/issues" },
  "license": "MIT",
  "author": "Todor Mazgalov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/todor-mazgalov/forjis.git",
    "directory": "forjis-runtime/cli"
  },
  "engines": { "node": ">=20" },
  "type": "module",
  "bin": { "forjis": "dist/bin/forjis.js" },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "test": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js --forceExit --testTimeout=60000",
    "clean": "rm -rf dist",
    "prepack": "node -e \"require('fs').copyFileSync('../../README.md','README.md')\""
  },
  "dependencies": {
    "@forjis/facilitator": "0.5.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.5.0"
  }
}
